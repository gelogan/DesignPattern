# 设置默认行为，统一转换为 LF
* text=auto eol=lf

# 明确 C/C++ 相关文本文件
*.c text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# 二进制文件不进行换行符转换
*.dll binary
*.lib binary
*.so binary
*.a binary
*.mp4 binary